# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# ---- Required: answer generator ----
LLM_PROVIDER=groq                   # slm | groq | openai | anthropic | openrouter
LLM_MODEL=qwen/qwen3.8-27b          # e.g. llama3.1:8b (slm), qwen/qwen3.8-27b (groq), gpt-4o-mini (openai), claude-3-5-haiku-20241022 (anthropic), google/gemma-4-31b-it:free (openrouter)
SLM_BASE_URL=http://localhost:11434/v1
SLM_API_KEY=ollama

# ---- Optional: embeddings ----
EMBEDDING_PROVIDER=local            # local | openai
EMBEDDING_MODEL=                    # e.g. nomic-embed-text (Ollama) | text-embedding-3-small (OpenAI)

# ---- Optional: speech engines ----
STT_PROVIDER=local                  # local | groq | openai   (local = faster-whisper)
STT_MODEL=base                      # whisper size for faster-whisper
TTS_PROVIDER=pyttsx3                # pyttsx3 | piper | edge
TTS_VOICE=

# ---- Retrieval tuning ----
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
